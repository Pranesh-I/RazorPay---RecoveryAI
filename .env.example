# ==============================================================================
# ReviveAI — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your local or test credentials.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# General Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Service URLs & Ports
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
WEB_PORT=3000
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
POSTGRES_USER=reviveai
POSTGRES_PASSWORD=reviveai_password
POSTGRES_DB=reviveai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reviveai:reviveai_password@localhost:5432/reviveai_db

# ------------------------------------------------------------------------------
# Redis & Celery (Task Queue & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Razorpay Integration (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# AI & LLM Services (Decision Engine & Autonomous Copy Generation)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Communication & Notification Channels (Intervention Delivery)
# ------------------------------------------------------------------------------
# WhatsApp / SMS (e.g. Twilio / Gupshup)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
WHATSAPP_SENDER_NUMBER=whatsapp:+14155238886

# Email (e.g. SendGrid / Resend)
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=notifications@reviveai.local

# ------------------------------------------------------------------------------
# Autonomous Agent Policy & Guardrails
# ------------------------------------------------------------------------------
MAX_DISCOUNT_PERCENTAGE=20
MAX_ATTEMPTS_PER_CUSTOMER=3
QUIET_HOURS_START_UTC=16
QUIET_HOURS_END_UTC=2
COOLING_OFF_PERIOD_HOURS=12
